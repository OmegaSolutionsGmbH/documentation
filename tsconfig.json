{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "types": ["vitepress/client"]
  },
  "include": [
    "docs/**/*.ts",
    "docs/**/*.tsx",
    "docs/**/*.mts",
    "docs/**/*.cts",
    "docs/**/*.vue",
    "docs/**/*.md"
  ],
  "vueCompilerOptions": {
    "vitePressExtensions": [".md"]
  }
}